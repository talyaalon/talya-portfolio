# Copy this file to ".env" and fill in your real values.
# The ".env" file is git-ignored and must NEVER be committed.

# --- Frontend (PUBLIC, safe to expose) ---
# Found in Supabase: Project Settings → Data API / API Keys
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Netlify Function (SECRET) ---
# These are NOT used by the browser. For local testing with `netlify dev`
# they're read from here; in production you set them in the Netlify UI.
# The service_role key is SECRET — never put it in VITE_ variables or commit it.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key
