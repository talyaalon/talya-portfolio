# Copy this file to ".env" and fill in your real values.
# The ".env" file is git-ignored and must NEVER be committed.

# --- Public site (PUBLIC values, safe to expose in the browser) ---
# Supabase: Project Settings -> Data API / API Keys
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# --- Admin area at /admin ---
# The Supabase user id of the site owner. Any other signed-in account is
# treated as an ordinary visitor. Find it with:
#     select id, email from auth.users;
# Not a secret (it is already inside the owner's own JWT), but it MUST be set:
# the admin area refuses to grant access rather than defaulting to "allow".
VITE_ADMIN_USER_ID=00000000-0000-0000-0000-000000000000

# Supabase Auth is email-based and has no username login. The admin form takes
# a username and appends this domain to build the account's email address, so
# a user created as "talya@portfolio.local" signs in by typing "talya".
# Use a domain you control if you want password-reset emails to work.
VITE_ADMIN_EMAIL_DOMAIN=portfolio.local

# --- Netlify Function (SECRET) ---
# NOT used by the browser. For local testing with `netlify dev` they are read
# from here; in production set them in the Netlify UI.
# The service_role key is SECRET - never put it in a VITE_ variable or commit it.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key

# Comma-separated origins allowed to POST to /api/track. Blocks other sites
# from injecting fake analytics events into your database.
ALLOWED_ORIGINS=https://talya-portfolio.netlify.app,http://localhost:5173
